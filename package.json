{
  "name": "atlas",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted personal travel companion — trips, flights, hotels, activities, documents, maps.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Sebastian Theimer",
  "repository": {
    "type": "git",
    "url": "https://github.com/SebboGit/atlas"
  },
  "bugs": {
    "url": "https://github.com/SebboGit/atlas/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm maplibre:worker && next dev",
    "dev:up": "docker compose up -d --wait postgres && pnpm db:setup && pnpm dev",
    "dev:up:wt": "docker compose up -d --wait postgres && pnpm db:setup && pnpm seed:dev && pnpm dev",
    "build": "pnpm maplibre:worker && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:reset": "docker compose down -v postgres && docker compose up -d --wait postgres && pnpm db:setup",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "seed:dev": "tsx --env-file-if-exists=.env scripts/seed-dev-fixture.ts",
    "db:prune": "tsx --env-file-if-exists=.env scripts/prune.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "docs:cleanup-orphans": "tsx --env-file-if-exists=.env scripts/cleanup-orphaned-documents.ts",
    "maplibre:worker": "tsx scripts/copy-maplibre-worker.ts",
    "tiles:fetch": "./scripts/fetch-tiles.sh",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@hookform/resolvers": "^5.9.1",
    "@photostructure/tz-lookup": "^11.7.0",
    "@protomaps/basemaps": "^5.7.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.2.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.2",
    "next-auth": "5.0.0-beta.32",
    "open-location-code": "^1.0.3",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "pmtiles": "^4.5.0",
    "postal-mime": "^2.7.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "unzipit": "^2.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-import": "^2.32.0",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
